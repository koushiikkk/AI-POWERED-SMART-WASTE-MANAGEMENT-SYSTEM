# ==================================================
# DATABASE ARCHITECTURE CONFIGURATION
# Set to 'mysql' for local MySQL or 'supabase' for Supabase PostgreSQL
# ==================================================
DATABASE_TYPE=mysql

# --------------------------------------------------
# OPTION A: LOCAL MYSQL CONFIGURATION
# --------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=exam_db

# --------------------------------------------------
# OPTION B: SUPABASE POSTGRESQL CONFIGURATION
# --------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# Direct Database URL (Optional Override)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/exam_db
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.project.supabase.co:5432/postgres

# --------------------------------------------------
# BACKEND SERVER CONFIGURATION
# --------------------------------------------------
PORT=8000
HOST=127.0.0.1
SECRET_KEY=CFX0J18yThn5U4m_mEE8g_9G1KDhD5
ENVIRONMENT=development

# --------------------------------------------------
# AWS CLOUD SERVICES CONFIGURATION (CSPM Dustbin Level Detection)
# --------------------------------------------------
# Region
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Credentials (Standard Boto3 Chain & AWS Academy Temporary Session Support)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Feature Flags (Enable/Disable services independently)
AWS_ENABLED=true
AWS_S3_ENABLED=true
AWS_DYNAMODB_ENABLED=true
AWS_SNS_ENABLED=true
AWS_CLOUDWATCH_ENABLED=true

# Resource Names
AWS_S3_BUCKET=cspm-dustbin-images-koushik-2026
AWS_DYNAMODB_TABLE=CSPM-Dustbin-Detections
AWS_SNS_TOPIC_NAME=CSPM-Dustbin-Alerts
AWS_SNS_TOPIC_ARN=
AWS_CLOUDWATCH_LOG_GROUP=CSPM-Dustbin-Application-Logs
AWS_CLOUDWATCH_LOG_STREAM=app-events
AWS_SNS_ALERT_COOLDOWN_SECONDS=3600
